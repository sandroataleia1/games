REALTIME_PORT=3001
WEB_ORIGIN=http://localhost:3000
MAX_PLAYERS=20
LOBBY_TTL_SECONDS=21600
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://onlinegames:onlinegames@127.0.0.1:5432/onlinegames
HTTP_AUTH_RATE_LIMIT=10
HTTP_AUTH_RATE_WINDOW_SECONDS=60
HTTP_RATE_LIMIT_NAMESPACE=quizarena:http:rate-limit
# Habilite somente quando houver exatamente um proxy reverso confiável.
TRUST_PROXY=false
