{
  "name": "quizarena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,realtime \"pnpm dev:web\" \"pnpm dev:realtime\"",
    "dev:web": "pnpm --filter @quizarena/web dev",
    "dev:realtime": "pnpm --filter @quizarena/realtime dev",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "lint": "eslint apps/realtime packages scripts vitest.config.js && pnpm --filter @quizarena/web lint",
    "test": "vitest run",
    "build": "pnpm --filter @quizarena/web build",
    "check": "pnpm test && pnpm lint && pnpm build && node scripts/check-web-bundle.js && pnpm db:verify",
    "format:check": "prettier --check apps/realtime/src apps/realtime/test apps/web/src packages/contracts docs README.md",
    "db:generate": "pnpm --filter @quizarena/database db:generate",
    "db:migrate": "pnpm --filter @quizarena/database db:migrate",
    "db:seed": "pnpm --filter @multygames/server-bootstrap run seed",
    "db:audit-quiz": "pnpm --filter @multygames/server-bootstrap run quiz-legacy-audit",
    "db:studio": "pnpm --filter @quizarena/database db:studio",
    "db:verify": "pnpm --filter @quizarena/database db:verify",
    "db:test:prepare": "pnpm --filter @quizarena/database db:test:prepare",
    "test:unit": "vitest run --exclude packages/server-bootstrap/test/postgres.test.js",
    "test:integration": "vitest run packages/server-bootstrap/test/postgres.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.5",
    "concurrently": "^9.2.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.0"
  }
}
